# Deal Sniper pipeline environment. Copy to .env and fill in secrets.
# Every value here is read by config/pipeline.yaml via ${VAR} expansion.
# The loader fails fast, listing missing names, when a command needs a var that is unset.

# --- Public API bases (standard public endpoints; change only if they move) ---
CENSUS_API_BASE=https://api.census.gov/data
# Full ArcGIS REST service URL for TIGERweb current vintage (layers are discovered by name at runtime)
CENSUS_TIGER_BASE=https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/tigerWMS_Current/MapServer
ARCGIS_HUB_API_BASE=https://hub.arcgis.com/api/v3
SOCRATA_DISCOVERY_API=https://api.us.socrata.com/api/catalog/v1

# --- Identity ---
# Set a real contact address so site operators can reach you (required before approving any scraper)
SCRAPER_USER_AGENT=DealSniperPipeline/0.1 (data-pipeline; contact: you@example.com)

# --- Secrets (required for DB writes / self-heal; not needed for discover or --dry-run) ---
DATABASE_URL=
ANTHROPIC_API_KEY=

# --- Self-heal ---
CLAUDE_MODEL=claude-opus-5

# --- Tiles (VM values shown; only needed for the tiles step) ---
TILES_DIR=/srv/tiles
TILES_BASE_URL=https://tiles.example.com/tiles

# --- Optional VM bootstrap tuning (read by scripts/bootstrap_vm.sh) ---
PG_SHARED_BUFFERS=4GB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=1GB
NGINX_CORS_ORIGIN=https://your-dealsniper-domain.example.com
