# ============================================================================
# Agent System — Required Environment Variables
# Add these to your .env file (backend/) or Render environment settings.
# ============================================================================

# --- Already required by the existing app ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...
# OPENAI_API_KEY=sk-...

# --- New: Agent System ---

# Encryption key for platform credentials (any random string, 32+ chars recommended)
AGENT_ENCRYPTION_KEY=replace-with-a-strong-random-key-here

# Redis URL for Celery task queue (optional — agent runs synchronously without it)
# REDIS_URL=redis://localhost:6379/0

# File storage backend: "supabase" (default) or "local"
# FILE_STORAGE_BACKEND=supabase
# AGENT_STORAGE_BUCKET=agent-files
